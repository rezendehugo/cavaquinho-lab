# Nunca coloque segredos em variáveis VITE_: elas são incorporadas ao bundle
# e ficam visíveis para qualquer pessoa no navegador.
VITE_API_URL=http://127.0.0.1:8080
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SENTRY_DSN=
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=
VITE_APP_VERSION=development
VITE_ENABLE_SCORE_IMPORTS=true
# Em produção, use uma URL HTTPS pública, por exemplo:
# VITE_API_URL=https://api.seu-dominio.com

# Somente servidor. Copie para apps/api/.env em desenvolvimento; nunca envie valores reais.
DATABASE_URL=postgres://cavaquinho:local-development-only@127.0.0.1:5432/cavaquinho_lab
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://127.0.0.1:5173/cavaquinho-lab
APP_ENV=development
APP_VERSION=development
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
HOST=127.0.0.1
PORT=8080

# Rede interna entre a API e o worker. Não exponha o worker à internet.
OMR_WORKER_URL=http://127.0.0.1:8090
PUBLIC_API_URL=http://127.0.0.1:8080
